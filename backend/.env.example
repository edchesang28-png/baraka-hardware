# ============================================
# BARAKA MINI HARDWARE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values

# ========== DATABASE ==========
# Local MongoDB (Development)
MONGODB_URI=mongodb://localhost:27017/baraka-hardware

# MongoDB Atlas (Cloud - Replace with your connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/baraka-hardware

# ========== SERVER ==========
PORT=5000
NODE_ENV=development

# ========== ADMIN CREDENTIALS ==========
ADMIN_PASSWORD=baraka2024

# ========== JWT SECRET (for authentication) ==========
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# ========== M-PESA / DARAJA API ==========
# Get these from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_safaricom_consumer_key
MPESA_CONSUMER_SECRET=your_safaricom_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd1a6b9f57
MPESA_ENVIRONMENT=sandbox

# ========== STRIPE PAYMENT (Optional) ==========
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# ========== WHATSAPP BUSINESS API ==========
# Get from: https://developers.facebook.com/docs/whatsapp
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ========== EMAIL NOTIFICATIONS ==========
# Using Gmail (or your email service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@barakahardware.com

# ========== FILE UPLOAD ==========
# Max file size in MB
MAX_FILE_SIZE=5

# Upload directory
UPLOAD_DIR=public/uploads

# ========== AWS S3 (Optional - for cloud storage) ==========
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=baraka-hardware-images

# ========== CLOUDINARY (Alternative to S3) ==========
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========== FRONTEND URL ==========
FRONTEND_URL=http://localhost:3000

# ========== API URL ==========
API_URL=http://localhost:5000

# ========== LOGGING ==========
LOG_LEVEL=debug

# ========== SESSION SECRET ==========
SESSION_SECRET=your_session_secret_key_32_characters

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========== STORE INFORMATION ==========
STORE_NAME=Baraka Mini Hardware
STORE_EMAIL=info@barakahardware.com
STORE_PHONE=+254712345678
STORE_ADDRESS=Baringo-Kabarnet, Kenya
STORE_CITY=Kabarnet
STORE_POSTAL_CODE=30400

# ========== SOCIAL MEDIA ==========
FACEBOOK_URL=https://facebook.com/barakahardware
INSTAGRAM_URL=https://instagram.com/barakahardware
WHATSAPP_URL=https://wa.me/254712345678
TWITTER_URL=https://twitter.com/barakahardware

# ========== GOOGLE ANALYTICS (Optional) ==========
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ========== SEO ==========
SEO_TITLE=Baraka Mini Hardware - Premium Furniture & Hardware Solutions
SEO_DESCRIPTION=Quality furniture and hardware products for Baringo-Kabarnet
SEO_KEYWORDS=furniture,hardware,paint,mattress,carpet,fabrics,Baringo,Kenya

# ========== TIMEZONE ==========
TIMEZONE=Africa/Nairobi

# ========== DEBUG MODE ==========
DEBUG=false

# ========== DEVELOPMENT/PRODUCTION FLAGS ==========
USE_MOCK_DATA=false
ENABLE_ADMIN_DASHBOARD=true

# Notes:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to version control
# 4. Keep .env.example in version control (without sensitive values)
# 5. For production, use strong, unique passwords and keys
# 6. Use environment-specific values for each deployment
